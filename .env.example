# Finnhub — free key at https://finnhub.io/register
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# LM Studio local server
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen

# Output
OUTPUT_DIR=output

# Market data service (http://<host>:8001) — no auth required
MARKET_DATA_URL=http://<host>:8001

# Sentiment service (http://<pc-ip>:8002)
SENTIMENT_API_URL=http://<pc-ip>:8002/api/v1/sentiment
SENTIMENT_API_KEY=
